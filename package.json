{
  "name": "datalingo",
  "version": "1.3.0",
  "description": "Datum: aprenda SQL, Python e estatística para análise de dados",
  "scripts": {
    "start": "npx --yes http-server -c-1 -p 8080 .",
    "validate": "node scripts/validate-content.mjs && python3 scripts/validate_python.py",
    "fetch:pyodide": "node scripts/fetch-pyodide.mjs",
    "icons": "node scripts/render-icons.cjs",
    "desktop": "npm run fetch:pyodide && electron .",
    "build:web": "node scripts/build-web.mjs",
    "dist:linux": "npm run fetch:pyodide && electron-builder --linux AppImage deb",
    "dist:win": "npm run fetch:pyodide && electron-builder --win nsis portable",
    "android:sync": "npm run fetch:pyodide && npm run build:web && npx cap sync android",
    "build:sdk": "esbuild scripts/anthropic-sdk-entry.mjs --bundle --format=esm --platform=browser --minify --legal-comments=eof --outfile=vendor/anthropic-sdk.js",
    "icons:build": "node scripts/render-icons.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelpalvador/app-datalearning.git"
  },
  "keywords": [
    "sql",
    "python",
    "pandas",
    "educação",
    "dados"
  ],
  "author": {
    "name": "DataLingo"
  },
  "license": "MIT",
  "homepage": "https://github.com/rafaelpalvador/app-datalearning",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@capacitor/cli": "^7.6.10",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.1",
    "@fontsource-variable/space-grotesk": "^5.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "lucide-static": "^0.460.0",
    "sql.js": "^1.10.3"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "app.datalingo.desktop",
    "productName": "Datum",
    "copyright": "Datum",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "index.html",
      "manifest.webmanifest",
      "css/**",
      "js/**",
      "vendor/**",
      "icons/**",
      "assets/icon.png",
      "desktop/**",
      "!**/*.map",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Datum",
      "language": "1046",
      "artifactName": "Datum-${version}-windows-instalador.${ext}"
    },
    "portable": {
      "artifactName": "Datum-${version}-windows-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Education",
      "synopsis": "SQL, Python e estatística para dados",
      "maintainer": "Datum <datum@users.noreply.github.com>",
      "artifactName": "Datum-${version}-linux-${arch}.${ext}",
      "executableName": "datum"
    },
    "deb": {
      "depends": [
        "libnss3",
        "libgtk-3-0",
        "libxss1",
        "libasound2"
      ]
    }
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.6"
  }
}

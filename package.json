{
  "name": "datalingo",
  "version": "1.1.0",
  "description": "App estilo Duolingo para aprender SQL e Python para análise de dados",
  "scripts": {
    "start": "npx --yes http-server -c-1 -p 8080 .",
    "validate": "node scripts/validate-content.mjs && python3 scripts/validate_python.py",
    "fetch:pyodide": "node scripts/fetch-pyodide.mjs",
    "icons": "node scripts/render-icons.cjs",
    "desktop": "npm run fetch:pyodide && electron .",
    "build:web": "node scripts/build-web.mjs",
    "dist:linux": "npm run fetch:pyodide && electron-builder --linux AppImage deb",
    "dist:win": "npm run fetch:pyodide && electron-builder --win nsis portable",
    "android:sync": "npm run fetch:pyodide && npm run build:web && npx cap sync android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelpalvador/app-datalearning.git"
  },
  "keywords": [
    "sql",
    "python",
    "pandas",
    "educação",
    "dados"
  ],
  "author": {
    "name": "DataLingo"
  },
  "license": "MIT",
  "homepage": "https://github.com/rafaelpalvador/app-datalearning",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "sql.js": "^1.10.3"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "app.datalingo.desktop",
    "productName": "DataLingo",
    "copyright": "DataLingo",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "index.html",
      "manifest.webmanifest",
      "css/**",
      "js/**",
      "vendor/**",
      "icons/**",
      "assets/icon.png",
      "desktop/**",
      "!**/*.map",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DataLingo",
      "language": "1046",
      "artifactName": "DataLingo-${version}-windows-instalador.${ext}"
    },
    "portable": {
      "artifactName": "DataLingo-${version}-windows-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Education",
      "synopsis": "Aprenda SQL e Python para dados",
      "maintainer": "DataLingo <datalingo@users.noreply.github.com>",
      "artifactName": "DataLingo-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libnss3",
        "libgtk-3-0",
        "libxss1",
        "libasound2"
      ]
    }
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.6"
  }
}
